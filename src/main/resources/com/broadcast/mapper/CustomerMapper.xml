<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.broadcast.mapper.CustomerMapper">

    <resultMap id="CustomerResultMap"
               type="com.broadcast.model.Customer">

        <id property="id"
            column="id"/>

        <result property="name"
                column="name"/>

        <result property="dateOfBirth"
                column="date_of_birth"/>

        <result property="phoneNumber"
                column="phone_number"/>

    </resultMap>

    <select id="findByDateOfBirthRange"
            resultMap="CustomerResultMap">
        <![CDATA[
        SELECT
        id,
        name,
        date_of_birth,
        phone_number
        FROM customer
        WHERE date_of_birth >= #{startDate}
        AND date_of_birth < #{endDate}
        ORDER BY id
        ]]>
    </select>

</mapper>